import { useNavigate } from 'react-router-dom';
import { getCurrentUser, getRoleLabel } from '../lib/auth';

/**
 * AccessDeniedPage — shown when an authenticated user navigates to a route
 * or triggers an API call they are not authorised to access.
 *
 * Design: consistent with the project theme (var(--theme-sidebar), bg-primary).
 * Displays the user's display name and role label for context.
 */
export function AccessDeniedPage() {
  const navigate = useNavigate();
  const user = getCurrentUser();
  const roleLabel = getRoleLabel(user?.roleName ?? null);

  return (
    <div className="flex min-h-[70vh] flex-col items-center justify-center px-6 text-center">
      {/* Shield / lock icon built from CSS */}
      <div
        className="mb-6 flex h-24 w-24 items-center justify-center rounded-full"
        style={{ background: 'var(--theme-sidebar, #15803d)', opacity: 0.12 }}
        aria-hidden="true"
      />
      <div
        className="absolute mb-[7.5rem] flex h-24 w-24 items-center justify-center rounded-full text-5xl"
        style={{ color: 'var(--theme-sidebar, #15803d)' }}
        aria-hidden="true"
      >
        🔒
      </div>

      <div className="mt-4">
        <p className="text-sm font-semibold uppercase tracking-widest text-slate-500">
          403 — Access Denied
        </p>
        <h1 className="mt-2 text-3xl font-bold text-slate-900">
          You don't have permission to view this page
        </h1>
        <p className="mt-3 max-w-md text-base text-slate-600">
          This section is restricted to <strong>Administrators</strong> only.
          {user ? (
            <>
              {' '}You are logged in as{' '}
              <strong>{user.displayName}</strong>{' '}
              (<span className="italic">{roleLabel}</span>).
            </>
          ) : null}
        </p>

        <div className="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <button
            id="access-denied-dashboard-btn"
            className="rounded bg-primary px-5 py-2 text-sm font-semibold text-white hover:opacity-90 transition-opacity"
            onClick={() => navigate('/dashboard')}
          >
            Go to Dashboard
          </button>
          <button
            id="access-denied-back-btn"
            className="rounded border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors"
            onClick={() => navigate(-1)}
          >
            Go Back
          </button>
        </div>
      </div>
    </div>
  );
}
