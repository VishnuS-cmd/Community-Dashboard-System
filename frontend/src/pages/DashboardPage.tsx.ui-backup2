import { useEffect, useState } from 'react';
import { apiRequest } from '../lib/api';
import { projectConfig } from '../project.config';

interface DomainStats {
  [entityName: string]: number;
}

// Skeleton card for loading state
function StatSkeleton() {
  return (
    <div className="stat-card">
      <div className="skeleton h-3 w-24 mb-3 rounded" />
      <div className="skeleton h-8 w-16 mb-2 rounded" />
      <div className="skeleton h-2.5 w-32 rounded" />
    </div>
  );
}

export function DashboardPage() {
  const [domainStats, setDomainStats] = useState<DomainStats>({});
  const [modules, setModules] = useState<string[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  useEffect(() => {
    void (async () => {
      setLoading(true);
      setError('');
      try {
        const [statsData, modulesData] = await Promise.all([
          apiRequest<DomainStats>('/dashboard/stats'),
          apiRequest<{ modules: string[] }>('/dashboard/modules')
        ]);
        setDomainStats(statsData);
        setModules(modulesData.modules ?? []);
      } catch (e: any) {
        setError(e.message || 'Failed to load dashboard data. Make sure the backend is running.');
      } finally {
        setLoading(false);
      }
    })();
  }, []);

  if (loading) {
    return (
      <section>
        {/* Header skeleton */}
        <div className="mb-6">
          <div className="skeleton h-7 w-72 mb-3 rounded" />
          <div className="skeleton h-4 w-96 rounded" />
        </div>
        <div className="grid grid-cols-2 gap-4 md:grid-cols-4">
          {[1, 2, 3, 4].map(i => <StatSkeleton key={i} />)}
        </div>
      </section>
    );
  }

  if (error) {
    return (
      <section>
        <div className="ui-alert ui-alert-error mb-4">
          <span className="text-lg mt-0.5">⚠</span>
          <div>
            <p className="font-semibold">Dashboard Unavailable</p>
            <p className="mt-0.5 text-sm opacity-90">{error}</p>
            <p className="mt-1 text-xs opacity-70">Make sure the backend server is running and the database is connected.</p>
          </div>
        </div>
      </section>
    );
  }

  // Color palette for stat cards
  const cardAccents = ['#15803d', '#0ea5e9', '#8b5cf6', '#f59e0b'];

  return (
    <section>
      {/* ── Page Header ── */}
      <div className="mb-7 flex items-start justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold text-slate-900">{projectConfig.dashboardTitle}</h1>
          <p className="mt-1.5 text-sm text-slate-500 max-w-2xl leading-relaxed">
            {projectConfig.dashboardIntro}
          </p>
        </div>
        <div
          className="hidden lg:flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold flex-shrink-0"
          style={{ background: '#f0fdf4', color: '#15803d', border: '1px solid #bbf7d0' }}
        >
          <span className="inline-block h-2 w-2 rounded-full bg-green-500 animate-pulse" />
          System Active
        </div>
      </div>

      {/* ── Stats Cards ── */}
      <div className="grid grid-cols-2 gap-4 md:grid-cols-4">
        {projectConfig.dashboardCards.map((card: any, idx: number) => {
          const entityKey = card.key?.startsWith('domain:') ? card.key.split(':')[1] : card.key;
          const liveValue = domainStats[entityKey] ?? domainStats[entityKey?.toLowerCase()] ?? Number(card.value) ?? 0;
          const accent = cardAccents[idx % cardAccents.length];
          return (
            <article
              key={card.key}
              className="stat-card"
              style={{ '--accent': accent } as React.CSSProperties}
            >
              <div
                className="mb-3 inline-flex h-9 w-9 items-center justify-center rounded-lg text-white text-sm font-bold"
                style={{ background: accent, boxShadow: `0 3px 8px ${accent}55` }}
              >
                {liveValue}
              </div>
              <p className="text-2xl font-extrabold text-slate-900 leading-none">{liveValue}</p>
              <p className="mt-1.5 text-sm font-semibold text-slate-700">{card.title}</p>
              <p className="mt-0.5 text-xs text-slate-400 leading-snug">{card.helper}</p>
            </article>
          );
        })}
      </div>

      {/* ── Domain Modules ── */}
      {projectConfig.domainModules && projectConfig.domainModules.length > 0 && (
        <div className="mt-8">
          <div className="flex items-center gap-2 mb-4">
            <h2 className="text-base font-bold text-slate-800">Active Modules</h2>
            <span
              className="px-2 py-0.5 rounded-full text-xs font-semibold"
              style={{ background: '#dcfce7', color: '#15803d' }}
            >
              {projectConfig.domainModules.length}
            </span>
          </div>
          <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
            {projectConfig.domainModules.map((mod: any) => (
              <article
                key={mod.title}
                className="rounded-xl p-4 border transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 cursor-default"
                style={{
                  background: '#fff',
                  border: '1px solid #e5e7eb'
                }}
              >
                <p className="text-lg font-extrabold text-slate-900">{mod.metric}</p>
                <p className="text-sm font-semibold text-slate-700 mt-0.5">{mod.title}</p>
                <p className="mt-1 text-xs text-slate-400 leading-relaxed line-clamp-2">{mod.description}</p>
              </article>
            ))}
          </div>
        </div>
      )}

      {/* ── System Modules Tags ── */}
      {modules.length > 0 && (
        <div className="mt-6">
          <h2 className="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">System Modules</h2>
          <div className="flex flex-wrap gap-2">
            {modules.map((item) => (
              <span
                key={item}
                className="px-3 py-1.5 rounded-full text-xs font-semibold capitalize"
                style={{ background: 'color-mix(in srgb, var(--theme-primary) 10%, transparent)', color: 'var(--theme-primary)' }}
              >
                {item.replace(/-/g, ' ')}
              </span>
            ))}
          </div>
        </div>
      )}

      {/* ── Insight Panels ── */}
      {projectConfig.insightPanels && projectConfig.insightPanels.length > 0 && (
        <div className="mt-8">
          <h2 className="text-base font-bold text-slate-800 mb-4">Workflow Insights</h2>
          <div className="grid gap-4 md:grid-cols-3">
            {projectConfig.insightPanels.map((panel: any) => (
              <article key={panel.title} className="theme-card p-4">
                <p className="text-sm font-semibold text-slate-700">{panel.title}</p>
                <p className="text-2xl font-extrabold mt-1" style={{ color: 'var(--theme-primary)' }}>{panel.value}</p>
                <p className="mt-1 text-xs text-slate-400">{panel.description}</p>
              </article>
            ))}
          </div>
        </div>
      )}
    </section>
  );
}