import { useState } from 'react';
import { apiRequest } from '../lib/api';

interface WorkflowPageProps {
  workflow: any;
}

export function WorkflowPage({ workflow }: WorkflowPageProps) {
  const [selectedStep, setSelectedStep] = useState<string | null>(null);
  const [message, setMessage] = useState('');
  const [isSuccess, setIsSuccess] = useState(false);
  const [busy, setBusy] = useState<string | null>(null);

  const steps = workflow.steps || [];

  async function handleStepClick(step: string) {
    setSelectedStep(step);
    setMessage('');
    setBusy(step);

    try {
      await apiRequest(`/domain/${workflow.name}`, {
        method: 'POST',
        body: JSON.stringify({
          workflow: workflow.name,
          step: step,
          status: 'Completed'
        })
      });

      setMessage(`${step} completed successfully.`);
      setIsSuccess(true);
    } catch (error) {
      setMessage(error instanceof Error ? error.message : 'Something went wrong.');
      setIsSuccess(false);
    } finally {
      setBusy(null);
    }
  }

  return (
    <section>

      {/* ── Page Header ── */}
      <div className="mb-6">
        <div className="flex items-center gap-3 mb-2">
          <div
            className="h-10 w-10 rounded-xl flex items-center justify-center text-xl flex-shrink-0"
            style={{ background: 'color-mix(in srgb, var(--theme-primary) 12%, transparent)' }}
          >
            ⚡
          </div>
          <div>
            <h1 className="text-xl font-bold text-slate-900">{workflow.label}</h1>
            <p className="text-sm text-slate-500">{workflow.description}</p>
          </div>
        </div>

        {/* Progress bar placeholder */}
        <div className="mt-4 flex items-center gap-2 text-xs text-slate-400">
          <span className="font-semibold text-slate-600">{steps.length} steps</span>
          <span>•</span>
          <span>Click a step to execute it</span>
        </div>
      </div>

      {/* ── Steps Grid ── */}
      <div className="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {steps.map((step: string, index: number) => {
          const isSelected = selectedStep === step;
          const isBusy = busy === step;

          return (
            <button
              key={step}
              type="button"
              onClick={() => handleStepClick(step)}
              disabled={isBusy}
              className="group relative rounded-xl p-5 text-left border transition-all duration-200"
              style={{
                background: isSelected
                  ? 'color-mix(in srgb, var(--theme-primary) 8%, white)'
                  : '#fff',
                border: isSelected
                  ? '1.5px solid var(--theme-primary)'
                  : '1.5px solid #e5e7eb',
                boxShadow: isSelected
                  ? '0 4px 16px color-mix(in srgb, var(--theme-primary) 20%, transparent)'
                  : '0 1px 3px rgba(0,0,0,.06)',
                cursor: isBusy ? 'wait' : 'pointer',
                transform: 'translateY(0)',
              }}
              onMouseEnter={e => {
                if (!isBusy) (e.currentTarget as HTMLElement).style.transform = 'translateY(-2px)';
              }}
              onMouseLeave={e => {
                (e.currentTarget as HTMLElement).style.transform = 'translateY(0)';
              }}
            >
              {/* Step number badge */}
              <div
                className="mb-3 flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold text-white"
                style={{
                  background: isSelected ? 'var(--theme-primary)' : '#9ca3af',
                  boxShadow: isSelected ? '0 2px 8px color-mix(in srgb, var(--theme-primary) 40%, transparent)' : 'none',
                  transition: 'background .15s, box-shadow .15s'
                }}
              >
                {isBusy ? (
                  <span className="inline-block h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent" />
                ) : (
                  index + 1
                )}
              </div>

              <p
                className="text-sm font-semibold leading-snug"
                style={{ color: isSelected ? 'var(--theme-primary)' : '#374151' }}
              >
                {step}
              </p>

              {isSelected && !isBusy && (
                <div
                  className="mt-2 text-xs font-semibold"
                  style={{ color: 'var(--theme-primary)' }}
                >
                  ✓ Executed
                </div>
              )}
            </button>
          );
        })}
      </div>

      {/* ── Result Panel ── */}
      {selectedStep && (
        <div
          className="mt-6 rounded-xl p-5"
          style={{
            background: isSuccess ? '#f0fdf4' : '#fef2f2',
            border: isSuccess ? '1.5px solid #bbf7d0' : '1.5px solid #fecaca'
          }}
        >
          <div className="flex items-start gap-3">
            <span className="text-xl">{isSuccess ? '✅' : '❌'}</span>
            <div>
              <p className="font-semibold text-sm" style={{ color: isSuccess ? '#15803d' : '#b91c1c' }}>
                Step: {selectedStep}
              </p>
              {message && (
                <p className="mt-1 text-sm" style={{ color: isSuccess ? '#166534' : '#991b1b' }}>
                  {message}
                </p>
              )}
            </div>
          </div>
        </div>
      )}
    </section>
  );
}