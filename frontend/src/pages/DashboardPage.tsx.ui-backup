import { useEffect, useState } from 'react';
import { apiRequest } from '../lib/api';
import { projectConfig } from '../project.config';
import { DomainVector } from '../theme/vectors';

interface DomainStats {
  [entityName: string]: number;
}

export function DashboardPage() {
  const [domainStats, setDomainStats] = useState<DomainStats>({});
  const [modules, setModules] = useState<string[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  useEffect(() => {
    void (async () => {
      setLoading(true);
      setError('');
      try {
        const [statsData, modulesData] = await Promise.all([
          apiRequest<DomainStats>('/dashboard/stats'),
          apiRequest<{ modules: string[] }>('/dashboard/modules')
        ]);
        setDomainStats(statsData);
        setModules(modulesData.modules ?? []);
      } catch (e: any) {
        setError(e.message || 'Failed to load dashboard data. Make sure the backend is running.');
      } finally {
        setLoading(false);
      }
    })();
  }, []);

  if (loading) {
    return (
      <section className="flex min-h-[300px] items-center justify-center">
        <div className="flex flex-col items-center gap-3">
          <div className="h-10 w-10 animate-spin rounded-full border-4 border-primary border-t-transparent" />
          <p className="text-sm text-slate-500">Loading dashboard...</p>
        </div>
      </section>
    );
  }

  if (error) {
    return (
      <section>
        <div className="theme-card mb-6 border-l-4 border-red-500 p-4">
          <p className="font-semibold text-red-700">Dashboard Unavailable</p>
          <p className="mt-1 text-sm text-slate-600">{error}</p>
          <p className="mt-2 text-xs text-slate-500">
            Make sure the backend server is running and the database is connected.
          </p>
        </div>
      </section>
    );
  }

  return (
    <section>
      <div className="mb-6 grid gap-5 lg:grid-cols-[1fr,300px]">
        <div>
          <h1 className="text-2xl font-semibold">{projectConfig.dashboardTitle}</h1>
          <p className="mt-2 text-sm text-slate-600">{projectConfig.dashboardIntro}</p>
        </div>
        <DomainVector className="hidden w-full lg:block" />
      </div>

      <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
        {projectConfig.dashboardCards.map((card: any) => {
          // card.key is like "domain:CommunityBeneficiary" or a direct key
          const entityKey = card.key?.startsWith('domain:') ? card.key.split(':')[1] : card.key;
          const liveValue = domainStats[entityKey] ?? domainStats[entityKey?.toLowerCase()] ?? Number(card.value) ?? 0;
          return (
            <article key={card.key} className="theme-card p-4">
              <p className="text-sm text-slate-500">{card.title}</p>
              <p className="text-2xl font-bold">{liveValue}</p>
              <p className="mt-1 text-xs text-slate-500">{card.helper}</p>
            </article>
          );
        })}
      </div>

      {projectConfig.domainModules && projectConfig.domainModules.length > 0 && (
        <>
          <h2 className="mt-8 text-lg font-semibold">Active Modules</h2>
          <div className="mt-3 grid gap-3 md:grid-cols-3 lg:grid-cols-5">
            {projectConfig.domainModules.map((mod: any) => (
              <article key={mod.title} className="theme-card p-3">
                <p className="text-sm font-medium">{mod.title}</p>
                <p className="text-2xl font-bold text-primary">{mod.metric}</p>
                <p className="mt-1 text-xs text-slate-500 line-clamp-2">{mod.description}</p>
              </article>
            ))}
          </div>
        </>
      )}

      {modules.length > 0 && (
        <div className="mt-6">
          <h2 className="text-sm font-semibold text-slate-500 uppercase">System Modules</h2>
          <ul className="mt-2 flex flex-wrap gap-2">
            {modules.map((item) => (
              <li key={item} className="rounded bg-primary/10 px-2 py-1 text-xs text-primary font-medium">
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

      {projectConfig.insightPanels && projectConfig.insightPanels.length > 0 && (
        <>
          <h2 className="mt-8 text-lg font-semibold">Workflow Insights</h2>
          <div className="mt-3 grid gap-3 md:grid-cols-3">
            {projectConfig.insightPanels.map((panel: any) => (
              <article key={panel.title} className="theme-card p-4">
                <p className="text-sm font-medium">{panel.title}</p>
                <p className="text-2xl font-bold text-primary">{panel.value}</p>
                <p className="mt-1 text-xs text-slate-500">{panel.description}</p>
              </article>
            ))}
          </div>
        </>
      )}
    </section>
  );
}