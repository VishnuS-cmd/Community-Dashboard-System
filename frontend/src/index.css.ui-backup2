@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color: var(--theme-text);
  background: var(--theme-background);
  font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--theme-background);
}

/* ── Scrollbar ───────────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--theme-primary) 30%, transparent); border-radius: 99px; }
::-webkit-scrollbar-thumb:hover { background: color-mix(in srgb, var(--theme-primary) 55%, transparent); }

/* ── Theme Root ──────────────────────────────────────────── */
.theme-root {
  min-height: 100vh;
  color: var(--theme-text);
  background:
    radial-gradient(ellipse at top right, color-mix(in srgb, var(--theme-accent) 10%, transparent) 0, transparent 55%),
    radial-gradient(ellipse at bottom left, color-mix(in srgb, var(--theme-primary) 8%, transparent) 0, transparent 55%),
    linear-gradient(160deg, var(--theme-background) 0%, color-mix(in srgb, var(--theme-muted) 35%, white) 100%);
}

/* ── Surface ─────────────────────────────────────────────── */
.theme-surface {
  border-radius: var(--theme-radius);
  background: var(--theme-surface);
}

/* ── Cards ───────────────────────────────────────────────── */
.theme-card {
  border-radius: var(--theme-radius);
  border: 1px solid color-mix(in srgb, var(--theme-border) 55%, white);
  background: color-mix(in srgb, var(--theme-surface) 97%, var(--theme-muted));
  box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
  transition: box-shadow .18s ease, transform .18s ease, border-color .18s ease;
}
.theme-card:hover {
  box-shadow: 0 4px 16px rgba(0,0,0,.10), 0 2px 6px rgba(0,0,0,.06);
}

/* ── Sidebar Nav Links ───────────────────────────────────── */
.theme-link {
  display: block;
  border-radius: 8px;
  padding: 0.5rem 0.75rem;
  font-size: 0.875rem;
  font-weight: 500;
  color: #374151;
  transition: background .15s ease, color .15s ease, transform .12s ease;
  text-decoration: none;
}
.theme-link:hover {
  background: color-mix(in srgb, var(--theme-primary) 10%, transparent);
  color: var(--theme-primary);
  transform: translateX(2px);
}
.theme-link.active {
  background: color-mix(in srgb, var(--theme-primary) 14%, transparent);
  color: var(--theme-primary);
  font-weight: 600;
}

/* ── Background Patterns ─────────────────────────────────── */
.theme-command-center {
  background:
    linear-gradient(90deg, color-mix(in srgb, var(--theme-primary) 5%, transparent) 1px, transparent 1px),
    linear-gradient(color-mix(in srgb, var(--theme-primary) 5%, transparent) 1px, transparent 1px),
    var(--theme-background);
  background-size: 28px 28px;
}

.theme-academic-studio,
.theme-clinical-console,
.theme-workflow-board,
.theme-ledger-grid,
.theme-field-ops,
.theme-ngo-community-major-project {
  background:
    linear-gradient(135deg, var(--theme-background), color-mix(in srgb, var(--theme-muted) 45%, white)),
    var(--theme-background);
}

/* ── Card variants ───────────────────────────────────────── */
.cards-flat .theme-card { border-color: transparent; box-shadow: none; }
.cards-elevated .theme-card {
  border-color: color-mix(in srgb, var(--theme-border) 35%, white);
  box-shadow: 0 4px 20px rgba(0,0,0,.09), 0 1px 4px rgba(0,0,0,.05);
}
.cards-insight-panel .theme-card {
  border-color: color-mix(in srgb, var(--theme-primary) 18%, white);
  box-shadow: 0 2px 8px rgba(0,0,0,.07);
}

/* ── Form Controls ───────────────────────────────────────── */
.ui-input {
  width: 100%;
  border-radius: 8px;
  border: 1.5px solid #d1d5db;
  padding: 0.5rem 0.75rem;
  font-size: 0.875rem;
  background: #fff;
  color: #111827;
  transition: border-color .15s ease, box-shadow .15s ease;
  outline: none;
}
.ui-input:focus {
  border-color: var(--theme-primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--theme-primary) 18%, transparent);
}
.ui-input::placeholder { color: #9ca3af; }

/* ── Buttons ─────────────────────────────────────────────── */
.ui-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  border-radius: 8px;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all .15s ease;
  border: none;
  outline: none;
  white-space: nowrap;
}
.ui-btn:disabled { opacity: 0.55; cursor: not-allowed; }

.ui-btn-primary {
  background: var(--theme-primary);
  color: #fff;
  box-shadow: 0 1px 3px color-mix(in srgb, var(--theme-primary) 40%, transparent);
}
.ui-btn-primary:hover:not(:disabled) {
  background: color-mix(in srgb, var(--theme-primary) 88%, #000);
  box-shadow: 0 3px 10px color-mix(in srgb, var(--theme-primary) 40%, transparent);
  transform: translateY(-1px);
}
.ui-btn-primary:active:not(:disabled) { transform: translateY(0); }

.ui-btn-danger {
  background: #dc2626;
  color: #fff;
}
.ui-btn-danger:hover:not(:disabled) {
  background: #b91c1c;
  box-shadow: 0 3px 10px rgba(220,38,38,.35);
  transform: translateY(-1px);
}

.ui-btn-ghost {
  background: transparent;
  color: #374151;
  border: 1.5px solid #d1d5db;
}
.ui-btn-ghost:hover:not(:disabled) {
  background: #f9fafb;
  border-color: #9ca3af;
}

.ui-btn-edit {
  background: color-mix(in srgb, #2563eb 10%, transparent);
  color: #1d4ed8;
  border: 1px solid color-mix(in srgb, #2563eb 25%, transparent);
}
.ui-btn-edit:hover:not(:disabled) {
  background: color-mix(in srgb, #2563eb 18%, transparent);
  transform: translateY(-1px);
}

/* ── Status Badges ───────────────────────────────────────── */
.badge {
  display: inline-flex;
  align-items: center;
  border-radius: 99px;
  padding: 0.15rem 0.6rem;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  white-space: nowrap;
}
.badge-green  { background: #dcfce7; color: #15803d; }
.badge-yellow { background: #fef9c3; color: #854d0e; }
.badge-blue   { background: #dbeafe; color: #1d4ed8; }
.badge-red    { background: #fee2e2; color: #b91c1c; }
.badge-gray   { background: #f3f4f6; color: #4b5563; }
.badge-purple { background: #ede9fe; color: #6d28d9; }

/* ── Alert Banners ───────────────────────────────────────── */
.ui-alert {
  border-radius: 10px;
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  display: flex;
  align-items: flex-start;
  gap: 0.625rem;
}
.ui-alert-error   { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }
.ui-alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; }
.ui-alert-info    { background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; }

/* ── Table ───────────────────────────────────────────────── */
.ui-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
.ui-table thead th {
  padding: 0.625rem 0.875rem;
  font-weight: 600;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #6b7280;
  background: #f9fafb;
  border-bottom: 1.5px solid #e5e7eb;
  text-align: left;
}
.ui-table tbody td {
  padding: 0.625rem 0.875rem;
  border-bottom: 1px solid #f3f4f6;
  color: #374151;
}
.ui-table tbody tr { transition: background .12s ease; }
.ui-table tbody tr:hover { background: #f8fafc; }
.ui-table tbody tr:last-child td { border-bottom: none; }

/* ── Skeleton shimmer ────────────────────────────────────── */
@keyframes shimmer {
  0%   { background-position: -400px 0; }
  100% { background-position: 400px 0; }
}
.skeleton {
  border-radius: 6px;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 800px 100%;
  animation: shimmer 1.4s infinite linear;
}

/* ── Stat cards ──────────────────────────────────────────── */
.stat-card {
  border-radius: var(--theme-radius);
  padding: 1.25rem;
  border: 1px solid color-mix(in srgb, var(--theme-primary) 14%, white);
  background: linear-gradient(135deg,
    var(--theme-surface),
    color-mix(in srgb, var(--theme-muted) 28%, white));
  box-shadow: 0 2px 8px rgba(0,0,0,.06);
  transition: box-shadow .18s ease, transform .18s ease;
  position: relative;
  overflow: hidden;
}
.stat-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 3px; height: 100%;
  background: var(--theme-primary);
  border-radius: 3px 0 0 3px;
}
.stat-card:hover {
  box-shadow: 0 6px 20px rgba(0,0,0,.10);
  transform: translateY(-2px);
}

/* ── Sidebar styles ──────────────────────────────────────── */
.sidebar-nav-group {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #9ca3af;
  padding: 0 0.75rem;
  margin-bottom: 0.375rem;
  margin-top: 0.5rem;
}
